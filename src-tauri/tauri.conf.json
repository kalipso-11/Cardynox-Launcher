{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cardynox Launcher",
  "version": "0.1.0",
  "identifier": "com.cardynox.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cardynox Launcher",
        "width": 620,
        "height": 370,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "alwaysOnTop": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https://cdn.cloudflare.steamstatic.com https://shared.akamai.steamstatic.com https://*.steamgriddb.com",
      "assetProtocol": {
        "enable": true,
        "scope": [ "$APPCONFIG/covers/*", "$APPCONFIG/covers/**/*" ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
